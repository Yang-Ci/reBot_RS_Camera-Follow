<?xml version="1.0"?>
<!-- Nominal CAD assembly. Origin approximates the midpoint of the two front lenses;
     actual RGB optical center and bracket fit require physical verification. -->
<robot name="gemini305_centered">
  <link name="gripper_end"/>
  <link name="camera_color_optical_frame">
    <!-- Approximate camera body; the optical frame remains the control reference. -->
    <visual><origin xyz="0 0 -0.012"/><geometry><box size="0.054 0.035 0.024"/></geometry><material name="camera"><color rgba="0.14 0.16 0.17 1"/></material></visual>
  </link>
  <link name="camera_mount_link">
    <visual><origin xyz="0.0002 -0.04472 0.03452"/><geometry><mesh filename="meshes/Gemini305_D405_Mount.stl" scale="0.001 0.001 0.001"/></geometry><material name="mount"><color rgba="0.05 0.05 0.06 1"/></material></visual>
  </link>
  <joint name="gripper_to_mount" type="fixed">
    <parent link="gripper_end"/><child link="camera_mount_link"/>
    <origin xyz="-0.1201 0.0003 0.045" rpy="1.5827 0.0024 1.5515"/>
  </joint>
  <joint name="gripper_to_color_optical" type="fixed">
    <parent link="gripper_end"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="-0.08247829 -0.00036825 0.07237040" rpy="-1.5827 -0.0024 -1.59009265"/>
  </joint>
</robot>
